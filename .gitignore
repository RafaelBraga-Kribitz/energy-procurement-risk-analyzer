# EN-091 — canonical ignore list (SPEC-07 §9)
.venv/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml
*.egg-info/
dist/
build/

.env
.claude/
.cursor/

# bulk data is never versioned (ING-010); repo stays reproducible via code + re-pull
data/raw/*
!data/raw/.gitkeep
data/cache/*
!data/cache/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/warehouse/*
!data/warehouse/.gitkeep

exports/*.csv

# operational ingest logs (EN-060); gate evidence is reports/ingestion/validation_*.md
reports/ingestion/*.log

# operational build-report logs (EN-060); the D-02 report itself is
# reports/warehouse/dbt_build_*.md (committed at 04-08)
reports/warehouse/*.log

# graphify staging + caches (canonical SSOT: .planning/graphs/ — see CONTINUITY.md)
graphify-out/
.planning/graphs/.last-build-snapshot.json

# ephemeral mid-task pause markers (regenerated by /gsd-pause-work)
**/.continue-here.md

dbt/target/
dbt/logs/
dbt/dbt_packages/
dbt/.user.yml
